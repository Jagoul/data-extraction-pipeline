# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Required for `extractor extract | run | ab-test` and `pytest -m live`.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# EXTRACTOR_MODEL=claude-opus-5-5
# EXTRACTOR_EFFORT=medium            # low | medium | high | xhigh | max
# EXTRACTOR_MAX_TOKENS=8192          # a response that hits this is chunked and resubmitted
# EXTRACTOR_MAX_ATTEMPTS=3           # validation attempts per document
# EXTRACTOR_CHUNK_TOKENS=6000        # chunk size for oversized documents
# EXTRACTOR_REVIEW_THRESHOLD=0.75    # confidence below this routes a field to a human
# EXTRACTOR_CRITICAL_THRESHOLD=0.85  # stricter bar for sample_size, doi, study_type
# EXTRACTOR_SLA_HOURS=4              # processing-time SLA for a run
# EXTRACTOR_POLL_SECONDS=20          # batch status polling interval
